# Copia este archivo a .env y rellena. NUNCA compartas la private key ni la pegues en chats.
DRY_RUN=1            # 1 = simula sin enviar nada; 0 = opera de verdad
TESTNET=0            # 1 = testnet de Lighter (necesitas cuenta/clave de testnet)
SYMBOL=BTC           # mercado inicial
SYMBOLS=BTC,LIT,HYPE # lista del selector
LEVERAGE=50          # leverage del mercado inicial
LIT_LEVERAGE=5
HYPE_LEVERAGE=20     # máximo permitido actualmente por Lighter
MARGIN_PCT=10        # % del portfolio usado como margen por entrada (10% x 50 = posicion de 5x equity)
SLIPPAGE_PCT=0.3     # peor precio aceptable en las market orders
STOP_PCT=0.3         # stop del mercado inicial (%); 0 = sin stop
LIT_STOP_PCT=1.0
HYPE_STOP_PCT=0.75
WEB_PORT=8787        # solo loopback 127.0.0.1; no exponer a LAN ni Internet

# Teclas: Q compra, W vende, E cierra toda la posicion. Ctrl+C sale.

# Solo necesarias con DRY_RUN=0:
ACCOUNT_INDEX=
API_KEY_INDEX=       # usa un indice dedicado, distinto del de la web de Lighter
API_PRIVATE_KEY=     # hexadecimal, sin 0x
